<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
  <link rel="stylesheet" href="/stylesheets/profile.css">
</head>

<body>
  <!-- <h1 class="text-center">Welcome, <%= user.fullname %></h1> -->
  <!-- <div class="profile-photo container text-center">
    <% if (user.profilePhoto) { %>
      <img src="<%= user.profilePhoto %>" alt="Profile Photo" class="photo rounded-circle">
    <% } else { %>
      <p>No profile photo uploaded</p>
    <% } %>
    <form action="/upload-photo" method="post" enctype="multipart/form-data" class="mt-3">
      <input type="file" name="profilePhoto" accept="image/*" class="form-control mb-2">
      <button type="submit" class="btn btn-success">Upload Photo</button>
    </form> -->

  <div class="container d-flex justify-content-center align-items-center">

    <div class="card">

      <div class="upper">

        <img src="https://i.imgur.com/Qtrsrk5.jpg" class="img-fluid">

      </div>

      <div class="user text-center">

        <div class="profile">

          <% if (user.profileImage) { %>
            <img src="/images/uploads/<%= user.profileImage %>" class="rounded-circle profile-photo-clickable" width="80" height="80" alt="Profile Photo">
          <% } else { %>
            <img src="https://i.imgur.com/JgYD2nQ.jpg" class="rounded-circle profile-photo-clickable" width="80" height="80" alt="Default Profile Photo">
          <% } %>
        </div>

      </div>


      <div class="mt-5 text-center">

        <h4 class="mb-0">
          <%= user.fullname %>
        </h4>
        <span class="text-muted d-block mb-2">
          <%= user.email %>
        </span>

        <a href="/logout" class="btn btn-primary btn-sm follow">Logout</a>

        <!-- Profile Photo Upload Modal -->
        <div id="profilePhotoModal" class="modal">
          <div class="modal-content">
            <span class="close-button">&times;</span>
            <h2>Upload/Change Profile Photo</h2>
            <form action="/upload" method="post" enctype="multipart/form-data" id="profilePhotoForm">
              <input type="file" name="file" class="form-control mb-2" required>
              <input type="hidden" name="isProfilePhoto" value="true">
              <button type="submit" class="btn btn-success">Save/Upload Photo</button>
            </form>
            <% if (user.profileImage) { %>
              <form action="/remove-profile-photo" method="post" class="mt-2">
                <button type="submit" class="btn btn-danger">Remove Profile Photo</button>
              </form>
            <% } %>
          </div>
        </div>


        <form action="/upload" method="post" enctype="multipart/form-data" class="mt-3">
          <input type="file" name="file" class="form-control mb-2">
          <input type="text" name="filecaption" placeholder="File Caption" class="form-control mb-2">
          <button type="submit" class="btn btn-primary">Upload New Post</button>
        </form>

        

      </div>

    </div>

  </div>


  </div>
  <br />
  <!-- </div> -->
  <!-- <p class="text-center">Username: <%= user.username %></p>
  <p class="text-center">Email: <%= user.email %></p>
  <a href="/logout" class="btn btn-primary mt-3">Logout</a> -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('profilePhotoModal');
      const profilePhoto = document.querySelector('.profile-photo-clickable');
      const closeButton = document.querySelector('.close-button');
      const profilePhotoForm = document.getElementById('profilePhotoForm');

      profilePhoto.addEventListener('click', function() {
        modal.style.display = 'block';
      });

      closeButton.addEventListener('click', function() {
        modal.style.display = 'none';
      });

      window.addEventListener('click', function(event) {
        if (event.target == modal) {
          modal.style.display = 'none';
        }
      });

      profilePhotoForm.addEventListener('submit', function(event) {
        // This will handle the form submission. For a full SPA experience, you'd use fetch API here.
        // For now, it will submit and reload the page, which is acceptable for a basic implementation.
        // If successful, the page reload will reflect the new image.
      });
    });
  </script>

  <div class="container_card">
    <% user.posts.forEach(function(post){ %>
      <div class="card">
        <img src="/images/uploads/<%= post.postImage %>" class="card-img-top" alt="<%= post.imageText %>">
        <div class="card-body">
          <h5 class="card-title"><%= post.imageText %></h5>
        </div>
      </div>
    <% }) %>
  </div>

</body>

</html>