<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/feed.css">
</head>
<body>
     <nav>
      <div class="logo">
        <h5>LOGO</h5>
		  
      </div>
      <ul class="navLink">
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
        <li><a href="#">Projects</a></li>
      </ul>
	  <div class="lines">
		  <div class="l1"></div>
		  <div class="l2"></div>
		  <div class="l3"></div>
	  </div>
    </nav>

<header>
  <h1>Pinterest Style Image Galley</h1>
  <h2>with Responsive Navigation Bar</h2>
</header> 

  
<div class="container">
      <% posts.forEach(function(post){ %>
        <div class="box">
          <a href="/images/uploads/<%= post.postImage %>">
            <img src="/images/uploads/<%= post.postImage %>" alt="<%= post.imageText %>" data-username="<%= post.user.username %>">
          </a>
          <div class="caption">
          </div>
        </div>
      <% }) %>
    </div>


  
  
