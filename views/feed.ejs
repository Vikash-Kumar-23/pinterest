<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/feed.css">
</head>
<body>
     <nav>
      <div class="logo">
         <img src="https://i.pinimg.com/originals/d3/d1/75/d3d175e560ae133f1ed5cd4ec173751a.png" alt="pin logo" class="img1" />
		  
      </div>
      <ul class="navLink">
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
	  <div class="lines">
		  <div class="l1"></div>
		  <div class="l2"></div>
		  <div class="l3"></div>
	  </div>
    </nav>

<header>
  <h1>Pinterest Style Image Galley</h1>
  <h2>with Responsive Navigation Bar</h2>
</header> 

  
<div class="container">
      <% posts.forEach(function(post){ %>
        <div class="box">
          <a href="/images/uploads/<%= post.postImage %>">
            <img src="/images/uploads/<%= post.postImage %>" alt="<%= post.imageText %>" data-username="<%= post.user.username %>">
          </a>
          <div class="caption">
          </div>
        </div>
      <% }) %>
    </div>


  
  

	  <div id="imageModal" class="modal">
    <span class="close-button">&times;</span>
    <img class="modal-content" id="modalImage">
    <div id="captionText" class="modal-caption"></div>
  </div>

  <script src="app.js"></script>
</body>
				  

</html>